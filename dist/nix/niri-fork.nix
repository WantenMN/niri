{ stdenv
, lib
, fetchurl
, autoPatchelfHook
, makeWrapper
, cairo
, dbus
, libGL
, libglvnd
, libinput
, seatd
, libxkbcommon
, mesa
, pango
, pipewire
, systemd
, wayland
}:

# Niri fork (traditional tarball from GitHub Release).
# Generated + verified by CI (.github/workflows/fork-tarball.yml):
#   version/url/hash are filled in by CI on every push to release_fork and
#   uploaded as release asset `niri-fork.nix`. This file in dotfiles is a
#   copy fetched by pkgs/update-fork-tarballs.sh — do not edit hash by hand.
stdenv.mkDerivation rec {
  pname = "niri-fork";
  version = "0.0.0-unset";

  src = fetchurl {
    url = "https://github.com/WantenMN/niri/releases/download/fork-linux-x86_64/niri-linux-x86_64.tar.gz";
    hash = "sha256-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=";
  };

  # Tarball has multiple top-level entries (bin/ lib/ share/); unpack in place.
  sourceRoot = ".";

  nativeBuildInputs = [
    autoPatchelfHook
    makeWrapper
  ];

  buildInputs = [
    cairo
    dbus
    libGL
    libglvnd
    libinput
    seatd
    libxkbcommon
    mesa
    pango
    pipewire
    systemd
    wayland
    stdenv.cc.cc.lib
  ];

  # Tarball top level is bin/ lib/ share/ (no usr/ wrapper).
  # Shell completions are pre-generated by CI into share/.
  # Notes:
  # - libdisplay-info.so.1 is bundled in tarball lib/ (Ubuntu 0.1.x; nixpkgs
  #   only ships 0.3+/.so.3). autoPatchelf finds it via $out/lib, so no
  #   nixpkgs libdisplay-info input is needed.
  # - Ubuntu binary dlopens libwayland-*.so.0 / libEGL.so.1 at runtime
  #   (wayland-sys / smithay via libloading), not DT_NEEDED, so autoPatchelf
  #   never adds their store paths to RUNPATH. Upstream source builds force
  #   `-lEGL -lwayland-client --no-as-needed` for this; prebuilt wraps
  #   LD_LIBRARY_PATH instead (same as RUNPATH for dlopen).
  installPhase = ''
    runHook preInstall

    mkdir -p $out
    cp -r bin lib share $out/

    # Point the user service at the store binary (tarball has /usr/bin/niri).
    substituteInPlace $out/lib/systemd/user/niri.service \
      --replace-fail 'ExecStart=/usr/bin/niri' "ExecStart=$out/bin/niri"

    # niri-session execs bare `niri`; pin to the store path (systemctl /
    # dbus-update-activation-environment stay on PATH).
    substituteInPlace $out/bin/niri-session \
      --replace-fail 'exec niri --session' "exec $out/bin/niri --session"

    chmod +x $out/bin/niri $out/bin/niri-session

    # wayland + EGL are dlopen'd, not NEEDED: expose via wrapper.
    wrapProgram $out/bin/niri \
      --prefix LD_LIBRARY_PATH : "${lib.makeLibraryPath [ wayland libglvnd ]}"

    runHook postInstall
  '';

  meta = {
    description = "Niri scrollable-tiling Wayland compositor (fork prebuilt tarball)";
    homepage = "https://github.com/WantenMN/niri";
    license = lib.licenses.gpl3Only;
    platforms = [ "x86_64-linux" ];
    mainProgram = "niri";
  };
}
